# Normalize line endings in the repository; shell scripts stay LF even on a Windows checkout (bash needs it).
* text=auto eol=lf
*.sh text eol=lf
*.py text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.webp binary
*.mp4 binary
*.nro binary

# Language statistics: count the port's own code, not the SDK or the docs.
sdk/** linguist-vendored
docs/** linguist-documentation
# the README's clips stay out of the release zip (git archive): players download the builder, not the videos
docs/images/clips/** export-ignore
